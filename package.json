{
  "name": "noctilux-db-assistant",
  "displayName": "Noctilux — Intelligent Database Assistant",
  "description": "Natural language to SQL/NoSQL queries with AI. Connect any database, generate optimized queries, explain results, and track query history — all inside VS Code.",
  "version": "1.0.0",
  "publisher": "pratham2511",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pratham2511/Noctilux"
  },
  "bugs": {
    "url": "https://github.com/Pratham2511/Noctilux/issues"
  },
  "homepage": "https://github.com/Pratham2511/Noctilux#readme",
  "categories": [
    "AI",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "sql",
    "database",
    "ai",
    "natural language",
    "gemini",
    "postgresql",
    "mysql",
    "mongodb",
    "query",
    "nlp"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "galleryBanner": {
    "color": "#0A0F1E",
    "theme": "dark"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "noctilux-explorer",
          "title": "Noctilux",
          "icon": "media/sidebar.svg"
        }
      ]
    },
    "views": {
      "noctilux-explorer": [
        {
          "id": "noctilux.connections",
          "name": "Connections"
        },
        {
          "id": "noctilux.schema",
          "name": "Schema"
        },
        {
          "id": "noctilux.history",
          "name": "Recent Queries"
        }
      ]
    },
    "commands": [
      {
        "command": "noctilux.openChat",
        "title": "Noctilux: Open Chat Panel"
      },
      {
        "command": "noctilux.setApiKey",
        "title": "Noctilux: Set Gemini API Key"
      },
      {
        "command": "noctilux.clearApiKey",
        "title": "Noctilux: Remove API Key"
      },
      {
        "command": "noctilux.showSchema",
        "title": "Noctilux: Show Schema & ER Diagram"
      },
      {
        "command": "noctilux.openQueryTree",
        "title": "Noctilux: Open Query Tree"
      },
      {
        "command": "noctilux.runLastQuery",
        "title": "Noctilux: Run Last Query"
      },
      {
        "command": "noctilux.addConnection",
        "title": "Noctilux: Add Database Connection"
      },
      {
        "command": "noctilux.runRobustnessTest",
        "title": "Noctilux: Run Schema Evolution Robustness Test"
      },
      {
        "command": "noctilux.restartBackend",
        "title": "Noctilux: Restart Python Backend"
      },
      {
        "command": "noctilux.openGlossaryEditor",
        "title": "Noctilux: Open Business Glossary Editor"
      }
    ],
    "keybindings": [
      {
        "command": "noctilux.openChat",
        "key": "ctrl+shift+q",
        "mac": "cmd+shift+q"
      },
      {
        "command": "noctilux.runLastQuery",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r"
      },
      {
        "command": "noctilux.showSchema",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s"
      },
      {
        "command": "noctilux.openQueryTree",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t"
      }
    ],
    "configuration": {
      "title": "Noctilux",
      "properties": {
        "noctilux.llm.provider": {
          "type": "string",
          "enum": ["gemini", "groq", "local"],
          "default": "gemini",
          "description": "LLM provider. Gemini is recommended (free tier available)."
        },
        "noctilux.llm.geminiModel": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "Gemini model to use. Default is gemini-2.5-flash (free tier)."
        },
        "noctilux.llm.groqModel": {
          "type": "string",
          "default": "llama-3.3-70b-versatile",
          "description": "Groq model to use when provider is set to groq."
        },
        "noctilux.privacy.enableShield": {
          "type": "boolean",
          "default": true,
          "description": "Anonymize schema names before sending to cloud LLM."
        },
        "noctilux.query.rowLimit": {
          "type": "number",
          "default": 500,
          "minimum": 10,
          "maximum": 10000,
          "description": "Maximum rows returned per query execution."
        },
        "noctilux.execution.timeoutSeconds": {
          "type": "number",
          "default": 60,
          "description": "Query execution timeout in seconds."
        },
        "noctilux.execution.readOnlyByDefault": {
          "type": "boolean",
          "default": true,
          "description": "Block INSERT / UPDATE / DELETE / DROP unless write mode explicitly enabled."
        },
        "noctilux.backend.startPort": {
          "type": "number",
          "default": 8765,
          "description": "First port to attempt for the Python backend."
        },
        "noctilux.backend.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python interpreter to use when launching the backend."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:webview",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "cd webview && npm run build",
    "watch:webview": "cd webview && npm run dev",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "package": "vsce package --no-yarn"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  }
}
